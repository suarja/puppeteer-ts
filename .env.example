# Railway sets PORT automatically — the server listens on process.env.PORT.
# Override only for local dev.
PORT=3000

# Shared secret used to authenticate requests from the Be Viral Next.js
# app (Vercel). Must match `PDF_SERVICE_SECRET` set on Vercel.
# Generate with: `openssl rand -hex 32`
PDF_SECRET=replace-me-with-openssl-rand-hex-32
